{
  "name": "ludo-legends-online-monorepo",
  "version": "1.0.0",
  "description": "LUDO LEGENDS ONLINE — Enterprise Multi-Player Online Board Game Application",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server",
    "tests"
  ],
  "scripts": {
    "install:all": "npm install && npm run build --workspace=shared",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "test": "npm run test --workspace=tests",
    "test:unit": "npm run test:unit --workspace=tests",
    "test:integration": "npm run test:integration --workspace=tests",
    "lint": "eslint . --ext .ts,.tsx",
    "count-loc": "cloc client server shared tests"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
